gametitle=Enthusia Professional Racing - OPM Demo Disc 91 (SCUS-97443) - Prize Race
author=kingjack, realxp, AI assistance

// title menu: 9 (Free Run) -> 10 (Prize Race)
patch=1,EE,2017A774,extended,2410000A

// Prize Race heap spec {3MB,0x600,27MB,0x80} -> {1MB,0x600,17.5MB,0x80}; the demo pool is only 20.75MB
// (this is the real cause of the 0 FPS hang: 27MB alloc returns NULL)
patch=1,EE,2032E2D0,extended,00100000
patch=1,EE,2032E2D8,extended,01180000

// disable the demo-disc watchdog that kicks you back to the OPM menu after ~5 min
patch=1,EE,201FA0CC,extended,1000000A

// ================= expanded event table: all 19 records rewritten =================
// Round N plays record (N-1)%19 (state+8 is the round counter), so every round is a different race.
// Only the 15 demo cars and 3 demo courses are used. 6 cars per grid so the 1st/2nd/3rd payout
// schedule (x1.0 / x0.6 / x0.2 of bet*odds) applies.
